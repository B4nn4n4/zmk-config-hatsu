#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define FUNCTION 1
#define UPPER 2
#define LOWER 3
#define SYSTEM 4
#define MOUSE 5

/ {
    behaviors {
        bat: bat {
            compatible = "zmk,behavior-battery-indicator";
            display-name = "Battery Indicator";
            #binding-cells = <0>;
        };

        bootl: bootl {
            compatible = "hatsu,behavior-bootloader";
            display-name = "Bootloader";
            #binding-cells = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        layer_1 {
            label = "default";
            bindings = <
            &kp TAB &kp Q &kp W &kp E &kp R &kp T           &kp Y &kp U &kp I &kp O &kp P &kp BSPC
            &mt LCTRL ESC &kp A &kp S &kp D &kp F &kp G     &kp H &kp J &kp K &kp L &kp SEMICOLON &kp SQT
            &kp LSHFT &kp Z &kp X &kp C &kp V &kp B         &kp N &kp M &kp COMMA &kp PERIOD &kp SLASH &kp RIGHT_SHIFT
                        &kp CAPS &kp LCTRL                                  &kp LBKT &kp RBKT
                        &kp LGUI &mt LEFT_ALT RET                           &kp SPACE &kp RALT
                        &kp LALT &mo UPPER                                  &mo LOWER &kp RALT
                        &mo SYSTEM &mo FUNCTION                             &mo MOUSE &mo SYSTEM
            >;
        };

        layer_2 {
            label = "function";
            bindings = <
            &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6                &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
            &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6                &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL
            &trans &kp GRAVE &kp PSCRN &kp INS &kp HOME &kp END      &kp PG_UP &kp PG_DN &kp K_APP &kp UP &kp RIGHT &trans
                        &trans &trans                                             &kp LEFT &kp DOWN
                        &trans &trans                                             &trans &trans
                        &trans &trans                                             &trans &trans
                        &trans &trans                                             &trans &trans
            >;
        };

        layer_3 {
            label = "upper";
            bindings = <
            &trans &kp N1  &kp N2  &kp N3  &kp N4  &kp N5            &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp DEL
            &trans &trans &trans &trans &trans &trans                &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
            &trans &studio_unlock  &trans  &trans  &trans  &trans    &kp HOME  &kp PAGE_DOWN  &kp PG_UP  &kp END  &trans  &kp PRINTSCREEN
                        &trans &trans                                             &trans &trans
                        &trans &trans                                             &trans &trans
                        &trans &trans                                             &trans &trans
                        &trans &trans                                             &trans &trans
            >;
        };

        layer_4 {
            label = "lower";
            bindings = <
            &kp GRAVE  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp DELETE
            &kp TILDE  &trans  &trans  &trans  &trans  &trans           &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE
            &kp LSHFT  &trans  &trans  &trans  &trans  &trans           &kp UNDER  &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE  &kp TILDE
                        &trans &trans                                             &trans &trans
                        &trans &trans                                             &trans &trans
                        &trans &trans                                             &trans &trans
                        &trans &trans                                             &trans &trans
            >;
        };

        layer_5 {
            label = "system";
            bindings = <
            &bl BL_TOG &bat &sys_reset &bootl &bt BT_CLR &trans                &trans &bt BT_CLR &bootl &sys_reset &bat &bl BL_TOG
            &bt BT_NXT &trans &trans &trans &trans &trans                &trans &trans &trans &trans &trans &trans
            &bt BT_PRV &trans &trans &trans &trans &trans                &trans &trans &trans &trans &trans &trans
                   &trans &trans                                                   &trans &trans
                   &trans &trans                                                   &trans &trans
                   &trans &trans                                                   &trans &trans
                   &trans &trans                                                   &trans &trans
            >;
        };

        layer_6 {
            label = "mouse";
            bindings = <
            &trans &trans &trans &trans &trans &trans                &mkp LCLK       &mkp MCLK       &mkp RCLK     &trans          &trans &trans
            &trans &trans &trans &trans &trans &trans                &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT &trans &trans
            &trans &trans &trans &trans &trans &trans                &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT &trans &trans
                        &trans &trans                                             &trans &trans
                        &trans &trans                                             &trans &trans
                        &trans &trans                                             &trans &trans
                        &trans &trans                                             &trans &trans
            >;
        };

        layer_7 {
            label = "reserved";
            bindings = <
            &trans &trans &trans &trans &trans &trans                &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans                &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans                &trans &trans &trans &trans &trans &trans
                        &trans &trans                                             &trans &trans
                        &trans &trans                                             &trans &trans
                        &trans &trans                                             &trans &trans
                        &trans &trans                                             &trans &trans
            >;
        };
    };
};
