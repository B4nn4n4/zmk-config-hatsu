CONFIG_RETAINED_MEM=y
CONFIG_RETENTION=y
CONFIG_RETENTION_BOOT_MODE=y

CONFIG_ZMK_BLE=y
CONFIG_ZMK_USB=y
CONFIG_ZMK_SPLIT=y

CONFIG_I2C=y

# Enable MPU
CONFIG_ARM_MPU=y

# Use pinctrl
CONFIG_PINCTRL=y

# enable GPIO
CONFIG_GPIO=y

# SoftDevice-free nRF52840 with Adafruit UF2 bootloader
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

# Settings storage (bonds, backlight state) -- required on BOTH halves
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

CONFIG_ZMK_BOOT_MAGIC_KEY=y

CONFIG_ZMK_BACKLIGHT_MAP=y

# Custom sleep handled in battery_indicator.c; CONFIG_ZMK_SLEEP is off but
# these are needed to link zmk_pm_suspend_devices() and sys_poweroff().
CONFIG_ZMK_PM_DEVICE_SUSPEND_RESUME=y
CONFIG_PM_DEVICE=y
CONFIG_POWEROFF=y

CONFIG_ZMK_BATTERY_INDICATOR=y
CONFIG_ZMK_BATTERY_INDICATOR_COLOR=0x00FF00

CONFIG_ZMK_BATTERY_REPORTING=y
CONFIG_ZMK_BATTERY_REPORTING_FETCH_MODE_STATE_OF_CHARGE=y
